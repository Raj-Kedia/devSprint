# Environment
ENVIRONMENT=production

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=https://dev-sprint-235943437556.us-central1.run.app

# Google OAuth (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Gmail SMTP Email Delivery (Use a Google App Password for SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=DevSprint
SMTP_FROM_EMAIL=

# Primary Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/devsprint

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL=120
ENABLE_REDIS=true

# AI Standup Agent (Optional - will fall back to intelligent internal synthesizer if not set)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# CORS (Comma-separated allowed origins for production frontend)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://yourdomain.com"]
